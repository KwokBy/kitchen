page {
  --paper: #f3edda;
  --paper-light: #fbf7eb;
  --ink: #243b2e;
  --ink-soft: #607263;
  --tomato: #d85d3f;
  --sage: #78907c;
  --line: rgba(51, 73, 56, 0.16);
  min-height: 100%;
  color: var(--ink);
  background-color: var(--paper);
  background-image: repeating-radial-gradient(circle at 18% 22%, rgba(61,76,60,.035) 0 1rpx, transparent 1rpx 6rpx);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

view, text, button, input, textarea, image, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

button::after { border: 0; }

.page-shell { min-height: 100vh; padding: 28rpx 36rpx 170rpx; }
.eyebrow { display: block; color: var(--ink-soft); font-size: 20rpx; font-weight: 600; letter-spacing: 4rpx; }
.page-title { display: block; margin-top: 8rpx; font-family: STKaiti, KaiTi, serif; font-size: 48rpx; font-weight: 700; }
.page-subtitle { display: block; margin-top: 8rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.55; }
.paper-card { border: 1rpx solid rgba(53, 70, 55, .08); border-radius: 36rpx; background: rgba(255,255,255,.38); }
.primary-button, .soft-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: 999rpx; font-size: 28rpx; }
.primary-button { color: #fff; background: var(--ink); }
.soft-button { color: var(--ink); background: rgba(255,255,255,.68); border: 1rpx solid var(--line); }
.field-label { display: block; margin: 28rpx 0 12rpx; font-size: 24rpx; font-weight: 600; }
.text-input, .text-area { width: 100%; border: 1rpx solid rgba(53,70,55,.08); border-radius: 999rpx; background: rgba(255,255,255,.72); }
.text-input { height: 88rpx; padding: 0 28rpx; }
.text-area { min-height: 180rpx; padding: 24rpx 28rpx; border-radius: 28rpx; }
.chip-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip { padding: 16rpx 24rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: rgba(255,255,255,.55); font-size: 23rpx; }
.chip.is-active { color: #fff; background: var(--sage); border-color: var(--sage); }
.section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 34rpx 0 18rpx; }
.section-head text:first-child { font-family: STKaiti, KaiTi, serif; font-size: 32rpx; font-weight: 700; }
.section-head text:last-child { color: var(--ink-soft); font-size: 20rpx; }
.sheet-overlay { position: fixed; z-index: 300; inset: 0; display: flex; align-items: flex-end; background: rgba(25,38,29,.38); }
.bottom-sheet { width: 100%; max-height: calc(100vh - 28rpx); overflow-y: auto; padding: 28rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); overscroll-behavior: contain; border-radius: 42rpx 42rpx 0 0; background: var(--paper-light); box-shadow: 0 -24rpx 70rpx rgba(30,43,34,.18); }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22rpx; }
.sheet-head text, .sheet-head strong { display: block; }
.sheet-head text { color: var(--ink-soft); font-size: 20rpx; letter-spacing: 3rpx; }
.sheet-head strong { margin-top: 6rpx; font-family: STKaiti, KaiTi, serif; font-size: 38rpx; }
.sheet-close { display: flex; flex: 0 0 64rpx; align-items: center; justify-content: center; width: 64rpx; min-width: 64rpx; max-width: 64rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 50%; color: var(--ink); background: rgba(36,59,46,.08); font-size: 36rpx; line-height: 1; }
.date-chips { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; margin: 20rpx 0 26rpx; }
.date-chip { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; max-width: none; min-height: 70rpx; margin: 0; padding: 0 8rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--ink); background: rgba(255,255,255,.7); font-size: 22rpx; }
.date-chip.is-active { color: white; border-color: var(--sage); background: var(--sage); }
