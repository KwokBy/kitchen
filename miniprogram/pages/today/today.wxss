.today-page { padding-bottom: 180rpx; }
.today-top { display: flex; align-items: center; justify-content: space-between; }
.notification-entry { position: relative; flex: 0 0 104rpx; width: 104rpx; min-width: 104rpx; max-width: 104rpx; min-height: 56rpx; margin: 0; padding: 0; border-radius: 999rpx; color: #405848; background: rgba(255,255,255,.62); font-size: 20rpx; line-height: 56rpx; }
.notification-entry text { position: absolute; right: -5rpx; top: -9rpx; display: flex; align-items: center; justify-content: center; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 999rpx; color: #fff; background: #d85d3f; font-size: 16rpx; line-height: 1; }
.meal-notice { width: max-content; max-width: 88%; margin: 10rpx auto -12rpx; padding: 16rpx 30rpx; border-radius: 999rpx; color: white; background: #617b6b; font-size: 22rpx; text-align: center; }
.menu-book { display: block; width: 330rpx; height: 300rpx; margin: 0 auto; }
.quick-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.quick-actions button { display: flex; align-items: center; justify-content: center; gap: 10rpx; width: 100%; min-width: 0; min-height: 82rpx; margin: 0; padding: 0 12rpx; border: 1rpx solid rgba(53,70,55,.1); border-radius: 999rpx; font-size: 24rpx; line-height: 1; white-space: nowrap; }
.quick-actions button text { display: block; line-height: 1; }
.quick-actions .quick-icon { font-size: 25rpx; }
.quick-actions button.is-active { color: white; background: #617b6b; }
.kitchen-reminders { margin-top: 14rpx; }
.picker-reminder, .wechat-subscribe { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 92rpx; margin: 0; padding: 14rpx 22rpx; border: 1rpx solid rgba(120,144,124,.18); border-radius: 24rpx; color: #405848; background: rgba(120,144,124,.1); text-align: left; line-height: 1.25; }
.picker-reminder view, .picker-reminder view text, .picker-reminder strong, .wechat-subscribe view, .wechat-subscribe view text, .wechat-subscribe strong { display: block; }
.picker-reminder view text, .wechat-subscribe view text { color: #718175; font-size: 17rpx; }
.picker-reminder strong, .wechat-subscribe strong { margin-top: 5rpx; font-size: 21rpx; }
.picker-reminder .reminder-arrow, .wechat-subscribe > text { flex: 0 0 auto; margin-left: 16rpx; font-size: 18rpx; white-space: nowrap; }
.wechat-subscribe { margin-top: 10rpx; color: #fff; background: #405f4c; }
.wechat-subscribe view text { color: rgba(255,255,255,.7); }
.wechat-subscribe.is-setup { color: #405848; background: rgba(64,95,76,.09); }
.wechat-subscribe.is-setup view text { color: #718175; }
.missed-card { margin-top: 18rpx; padding: 20rpx 22rpx; border: 2rpx solid rgba(216,93,63,.16); border-radius: 30rpx; background: rgba(216,93,63,.06); }
.missed-head { display: flex; align-items: center; justify-content: space-between; }
.missed-head small, .missed-head strong { display: block; }
.missed-head small { color: #607263; font-size: 17rpx; }
.missed-head strong { margin-top: 4rpx; font-family: STKaiti, KaiTi, serif; font-size: 27rpx; }
.missed-head > text { padding: 8rpx 12rpx; border-radius: 999rpx; color: #c74f35; background: rgba(216,93,63,.1); font-size: 16rpx; }
.missed-row { display: grid; grid-template-columns: minmax(0, 1fr) 92rpx 92rpx; align-items: center; gap: 8rpx; padding-top: 16rpx; margin-top: 16rpx; border-top: 1rpx solid rgba(216,93,63,.13); }
.missed-row strong, .missed-row small { display: block; }
.missed-row strong { font-family: STKaiti, KaiTi, serif; font-size: 24rpx; }
.missed-row small { margin-top: 3rpx; color: #607263; font-size: 17rpx; }
.missed-row button { width: 92rpx; min-height: 50rpx; margin: 0; padding: 0; border-radius: 999rpx; color: #607263; background: rgba(255,255,255,.62); font-size: 17rpx; line-height: 50rpx; }
.missed-row button.today { color: #fff; background: #78907c; }
.today-section-head { margin-top: 22rpx; }
.today-board { overflow: hidden; margin: 0 -36rpx; padding: 20rpx 36rpx; background: #d8d2bd; background-image: linear-gradient(90deg, rgba(255,255,255,.22), rgba(97,123,107,.08)), repeating-linear-gradient(0deg, transparent 0 28rpx, rgba(255,255,255,.15) 28rpx 30rpx); }
.today-dish-scroll { width: 100%; white-space: nowrap; }
.today-dish-row { display: inline-flex; min-width: 100%; gap: 12rpx; }
.today-dish-row.is-few { justify-content: center; }
.today-dish-card { display: inline-flex; flex: 0 0 220rpx; flex-direction: column; align-items: center; min-width: 220rpx; padding: 0 8rpx 8rpx; }
.dish-composite { position: relative; }
.dish-composite .plate-layer, .dish-composite .food-layer { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
.dish-composite .plate-layer { width: 100%; height: 100%; }
.dish-composite .food-layer { z-index: 1; width: 62%; height: 62%; }
.today-dish-image { width: 150rpx; height: 150rpx; filter: drop-shadow(0 10rpx 10rpx rgba(48,52,45,.13)); }
.today-dish-card text, .today-dish-card small { display: block; max-width: 150rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.today-dish-card text { margin-top: 8rpx; font-family: STKaiti, KaiTi, serif; font-size: 24rpx; font-weight: 700; }
.today-dish-card small { margin-top: 2rpx; color: #607263; font-size: 17rpx; }
.empty-today { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 260rpx; }
.empty-today text { font-family: STKaiti, KaiTi, serif; font-size: 32rpx; }
.empty-today small { margin-top: 12rpx; color: #607263; font-size: 22rpx; }
.today-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 14rpx; }
.today-actions button { width: 100%; min-width: 0; min-height: 72rpx; margin: 0; padding: 0 10rpx; font-size: 23rpx; }
.today-actions button:only-child { grid-column: 1 / 3; }
.tomorrow-head { margin-top: 22rpx; }
.tomorrow-board { position: relative; display: grid; grid-template-columns: 1fr 170rpx 1fr; align-items: center; min-height: 230rpx; padding: 20rpx; overflow: hidden; border-radius: 34rpx; background: repeating-linear-gradient(0deg, transparent 0 38rpx, rgba(68,96,65,.24) 38rpx 76rpx), repeating-linear-gradient(90deg, rgba(163,122,80,.22) 0 38rpx, rgba(245,239,215,.64) 38rpx 76rpx); }
.tomorrow-board image { z-index: 2; width: 190rpx; height: 190rpx; margin-left: -10rpx; }
.tomorrow-board button { z-index: 1; width: 100%; min-width: 0; min-height: 76rpx; margin: 0; padding: 0 10rpx; border-radius: 26rpx; font-size: 22rpx; }
.history-row { width: 100%; white-space: nowrap; }
.history-item { display: inline-flex; flex-direction: column; align-items: center; width: 132rpx; margin-right: 18rpx; }
.history-dish-image { width: 104rpx; height: 104rpx; }
.history-item text { max-width: 128rpx; margin-top: 8rpx; overflow: hidden; font-family: STKaiti, KaiTi, serif; font-size: 21rpx; text-overflow: ellipsis; }
.history-empty { color: #607263; font-size: 23rpx; }
.notification-sheet { padding-bottom: calc(34rpx + env(safe-area-inset-bottom)); }
.notification-item { display: grid; grid-template-columns: 18rpx minmax(0, 1fr); gap: 14rpx; margin-top: 12rpx; padding: 20rpx; border-radius: 26rpx; background: rgba(255,255,255,.46); }
.notification-item.is-unread { background: rgba(120,144,124,.13); }
.notification-dot { width: 12rpx; height: 12rpx; margin-top: 10rpx; border-radius: 50%; background: rgba(120,144,124,.24); }
.notification-item.is-unread .notification-dot { background: #d85d3f; }
.notification-item strong, .notification-item text, .notification-item small { display: block; }
.notification-item strong { font-family: STKaiti, KaiTi, serif; font-size: 27rpx; }
.notification-item text { margin-top: 5rpx; color: #405848; font-size: 21rpx; line-height: 1.5; }
.notification-item small { margin-top: 7rpx; color: #879387; font-size: 17rpx; }
.notification-empty { padding: 56rpx 20rpx; text-align: center; }
.notification-empty strong, .notification-empty text { display: block; }
.notification-empty strong { font-family: STKaiti, KaiTi, serif; font-size: 30rpx; }
.notification-empty text { margin-top: 10rpx; color: #607263; font-size: 20rpx; }
