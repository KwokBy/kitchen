<view class="page-shell today-page">
  <view class="today-top"><text class="eyebrow">{{dateText}}</text><button class="notification-entry" bindtap="openNotifications">消息<text wx:if="{{unreadCount}}">{{unreadCount > 9 ? '9+' : unreadCount}}</text></button></view>
  <view wx:if="{{dishes.length}}" class="meal-notice">已为今日食谱安排 {{dishes.length}} 道菜</view>
  <image class="menu-book" src="/assets/illustrations/menu-book.png" mode="aspectFit" />
  <view class="quick-actions"><button class="soft-button" bindtap="goMenu"><text class="quick-icon">✦</text><text>我想吃的</text></button><button class="is-active" bindtap="goHistory"><text>我烧过的</text></button></view>
  <view class="kitchen-reminders">
    <button class="picker-reminder" bindtap="handleReminder"><view><text>{{reminderCaption}}</text><strong>{{reminderTitle}}</strong></view><text class="reminder-arrow">{{reminderAction}}</text></button>
    <button class="wechat-subscribe {{canSubscribeWechat ? '' : 'is-setup'}}" bindtap="subscribeWechat"><view><text>微信提醒</text><strong>{{canSubscribeWechat ? '接收搭档发来的下一条通知' : '登录并加入厨房后即可开启'}}</strong></view><text>{{canSubscribeWechat ? '开启 →' : '设置 →'}}</text></button>
  </view>

  <view wx:if="{{missedDishes.length}}" class="missed-card">
    <view class="missed-head"><view><small>计划有变化也没关系</small><strong>有 {{missedDishes.length}} 道菜那天没做</strong></view><text>未扣库存</text></view>
    <view class="missed-row" wx:for="{{missedDishes}}" wx:key="occurrenceId"><view><strong>{{item.name}}</strong><small>原计划 {{item.planDate}}</small></view><button class="today" data-id="{{item.id}}" data-date="{{item.planDate}}" bindtap="moveMissedToToday">今天做</button><button data-id="{{item.id}}" data-date="{{item.planDate}}" bindtap="clearMissed">暂不做</button></view>
  </view>

  <view class="section-head today-section-head"><text>今日食谱</text><text>{{dishes.length ? dishes.length + ' 道菜' : '还没安排'}}</text></view>
  <view class="today-board">
    <scroll-view wx:if="{{dishes.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="today-dish-scroll">
      <view class="today-dish-row {{dishes.length <= 2 ? 'is-few' : ''}}"><view wx:for="{{dishes}}" wx:key="id" class="today-dish-card"><view class="today-dish-image dish-composite"><image class="plate-layer" src="{{item.plateImage}}" mode="aspectFit" /><image class="food-layer" src="{{item.image}}" mode="aspectFit" /></view><text>{{item.name}}</text><small>{{item.note}}</small></view></view>
    </scroll-view>
    <view wx:else class="empty-today"><text>今天还没安排菜</text><small>先去菜单挑一道想吃的</small></view>
    <view class="today-actions"><button class="soft-button" bindtap="goMenu">帮我想道菜</button><button wx:if="{{dishes.length}}" class="primary-button" bindtap="startMeal">做完了，更新冰箱</button></view>
  </view>

  <view class="section-head tomorrow-head"><text>明日食谱</text><text>{{tomorrowDishes.length ? tomorrowDishes.length + ' 道菜' : '还没安排'}}</text></view>
  <view class="tomorrow-board"><button class="soft-button" bindtap="surpriseTomorrow">随便来一顿</button><image src="/assets/illustrations/meal-idea.png" mode="aspectFit" /><button class="soft-button" bindtap="addTomorrowDish">帮我想道菜</button></view>

  <view id="meal-history" class="section-head"><text>最近吃过</text><text>每一顿都算数</text></view>
  <scroll-view scroll-x class="history-row">
    <view class="history-item" wx:for="{{history}}" wx:key="id"><view class="history-dish-image dish-composite"><image class="plate-layer" src="{{item.dish.plateImage}}" mode="aspectFit" /><image class="food-layer" src="{{item.dish.image}}" mode="aspectFit" /></view><text>{{item.dish.name}}</text></view>
    <view wx:if="{{!history.length}}" class="history-empty">吃完第一顿，它会出现在这里。</view>
  </scroll-view>
</view>

<view wx:if="{{showNotifications}}" class="sheet-overlay" bindtap="closeNotifications"><view class="bottom-sheet notification-sheet" catchtap="noop"><view class="sheet-head"><view><text>厨房消息</text><strong>我们之间的小纸条</strong></view><button class="sheet-close" bindtap="closeNotifications">×</button></view><view wx:for="{{notifications}}" wx:key="id" class="notification-item {{item.isRead ? '' : 'is-unread'}}"><view class="notification-dot"></view><view><strong>{{item.title}}</strong><text>{{item.body}}</text><small>{{item.timeText}}</small></view></view><view wx:if="{{!notifications.length}}" class="notification-empty"><strong>还没有消息</strong><text>点好菜单或提醒点菜后，消息会出现在这里。</text></view></view></view>
