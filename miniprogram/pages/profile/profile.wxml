<view class="page-shell profile-page">
  <text class="eyebrow">我的</text><text class="page-title">{{state.profile.homeName}}</text><text class="page-subtitle">两个人的身份、共享厨房和菜单习惯。</text>
  <view class="family-card paper-card"><view class="person"><image wx:if="{{state.identity.profileComplete}}" src="{{state.identity.avatarUrl}}" mode="aspectFill" /><text wx:else>{{meInitial}}</text><view><strong>{{state.identity.profileComplete ? state.identity.nickname : state.profile.meName}}</strong><small>{{state.profile.meRole}}</small></view></view><em>一起开饭</em><view class="person partner"><text>{{partnerInitial}}</text><view><strong>{{state.profile.partnerName}}</strong><small>{{state.profile.partnerRole}}</small></view></view></view>

  <view wx:if="{{!state.identity.bound}}" class="wechat-login paper-card" bindtap="loginWechat"><text class="wechat-icon">微</text><view><strong>微信登录</strong><small>登录后创建或加入两个人的厨房</small></view><text class="login-arrow">›</text></view>
  <view wx:else class="wechat-login is-logged paper-card" bindtap="openWechatProfile"><image wx:if="{{state.identity.profileComplete}}" class="wechat-avatar" src="{{state.identity.avatarUrl}}" mode="aspectFill" /><text wx:else class="wechat-icon">微</text><view><strong>{{state.identity.profileComplete ? state.identity.nickname : '完善微信资料'}}</strong><small>{{state.identity.profileComplete ? '已通过微信登录' : '选择微信头像和昵称'}}</small></view><text class="logged-tag">{{state.identity.profileComplete ? '已登录' : '去完善'}}</text></view>

  <view class="kitchen-section">
    <view wx:if="{{state.kitchen}}" class="doorplate"><small>两个人的共享厨房</small><text>{{state.kitchen.name}}</text><small>厨房邀请码</small><strong>{{state.kitchen.inviteCode}}</strong><small>她打开分享卡片后即可加入</small><view class="member-state">{{state.kitchen.memberCount}} 位成员</view></view>
    <view wx:if="{{state.kitchen}}" class="invite-buttons"><button class="soft-button" bindtap="copyInvite">复制邀请码</button><button class="primary-button" open-type="share">分享给她</button></view>
    <block wx:else><view class="kitchen-empty paper-card"><text>⌂</text><view><strong>还没有共享厨房</strong><small>新建一个厨房，再邀请她加入。</small></view></view><button class="primary-button" bindtap="toggleCreate">＋ 新建厨房</button><form wx:if="{{showCreate}}" class="create-form paper-card" bindsubmit="createKitchen"><input class="text-input" name="name" value="{{state.profile.homeName}}" placeholder="厨房名称" /><button class="primary-button" form-type="submit">创建并生成邀请码</button></form><view class="join-row"><input class="text-input" maxlength="6" value="{{joinCode}}" bindinput="onJoinCode" placeholder="输入她发来的邀请码" /><button bindtap="joinKitchen">加入</button></view></block>
  </view>

  <form class="settings-card paper-card" bindsubmit="saveProfile"><text class="settings-title">身份信息</text><text class="field-label">家庭称呼</text><input class="text-input" name="homeName" value="{{state.profile.homeName}}" /><view class="pair-fields"><view><text class="field-label">另一半昵称</text><input class="text-input" name="partnerName" value="{{state.profile.partnerName}}" /></view><view><text class="field-label">我的身份</text><input class="text-input" name="meRole" value="{{state.profile.meRole}}" /></view><view><text class="field-label">她的身份</text><input class="text-input" name="partnerRole" value="{{state.profile.partnerRole}}" /></view></view><button class="primary-button" form-type="submit">保存身份信息</button></form>
  <view class="settings-card paper-card"><view class="section-head"><text>菜品大类</text><text>{{state.categories.length}} 类</text></view><view class="category-list"><view wx:for="{{state.categories}}" wx:key="*this">{{item}}<text data-category="{{item}}" bindtap="removeCategory">×</text></view></view><form class="category-add" bindsubmit="addCategory"><input class="text-input" name="category" placeholder="例如：烘焙" /><button form-type="submit">添加</button></form></view>
</view>

<view wx:if="{{showWechatProfile}}" class="sheet-overlay" bindtap="closeWechatProfile">
  <view class="bottom-sheet wechat-profile-sheet" catchtap="noop">
    <view class="sheet-head"><view><text>微信资料</text><strong>用你的头像和昵称</strong></view><button class="sheet-close" bindtap="closeWechatProfile">×</button></view>
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{draftAvatarUrl}}" src="{{draftAvatarUrl}}" mode="aspectFill" />
      <text wx:else>选择微信头像</text>
    </button>
    <text class="profile-tip">点击头像，选择“使用微信头像”</text>
    <text class="field-label">微信昵称</text>
    <input class="text-input nickname-input" type="nickname" value="{{draftNickname}}" bindinput="onNicknameInput" placeholder="点击选择微信昵称" />
    <button class="primary-button save-wechat-profile" bindtap="saveWechatProfile">使用这份微信资料</button>
  </view>
</view>
