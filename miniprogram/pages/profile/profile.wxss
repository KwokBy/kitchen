.profile-page { padding-bottom: 190rpx; }
.account-card { display: grid; grid-template-columns: 92rpx minmax(0, 1fr) auto; align-items: center; gap: 18rpx; margin-top: 28rpx; padding: 24rpx; border: 2rpx solid rgba(216,93,63,.18); border-radius: 34rpx; background: rgba(255,248,235,.72); box-shadow: 0 14rpx 30rpx rgba(57,67,55,.07); }
.account-card.is-bound { border-color: rgba(120,144,124,.2); background: rgba(255,255,255,.48); }
.account-avatar, .account-avatar image { width: 86rpx; height: 86rpx; border-radius: 50%; }
.account-avatar { display: flex; align-items: center; justify-content: center; overflow: hidden; color: #fff; background: #d85d3f; font-family: STKaiti, KaiTi, serif; font-size: 32rpx; }
.account-card.is-bound .account-avatar { background: #78907c; }
.account-copy { min-width: 0; }
.account-copy small, .account-copy strong, .account-copy text { display: block; }
.account-copy small { color: #78907c; font-size: 18rpx; }
.account-copy strong { margin-top: 3rpx; overflow: hidden; font-family: STKaiti, KaiTi, serif; font-size: 29rpx; white-space: nowrap; text-overflow: ellipsis; }
.account-copy text { margin-top: 4rpx; color: #607263; font-size: 18rpx; line-height: 1.4; }
button.account-action { width: auto; min-width: 128rpx; min-height: 62rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid rgba(36,59,46,.14); border-radius: 999rpx; color: #243b2e; background: rgba(255,255,255,.68); font-size: 20rpx; line-height: 62rpx; }
button.account-action.login { color: #fff; border-color: #243b2e; background: #243b2e; }
.profile-tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8rpx; margin-top: 24rpx; padding: 7rpx; border-radius: 999rpx; background: rgba(36,59,46,.07); }
.profile-tabs view { display: flex; align-items: center; justify-content: center; min-height: 68rpx; border-radius: 999rpx; color: #607263; font-size: 22rpx; }
.profile-tabs view.is-active { color: white; background: #243b2e; box-shadow: 0 8rpx 18rpx rgba(36,59,46,.16); }
.kitchen-section { margin-top: 22rpx; }
.kitchen-label { padding: 28rpx 30rpx; border-radius: 34rpx; color: #fff; background: #243b2e; }
.kitchen-label text, .kitchen-label strong, .kitchen-label small { display: block; }
.kitchen-label text { color: rgba(255,255,255,.58); font-size: 18rpx; }
.kitchen-label strong { margin-top: 6rpx; font-family: STKaiti, KaiTi, serif; font-size: 38rpx; }
.kitchen-label small { margin-top: 8rpx; color: rgba(255,255,255,.65); font-size: 19rpx; }
.members-card { margin-top: 16rpx; padding: 8rpx 24rpx; }
.members-card .section-head { margin: 0; padding: 20rpx 0 10rpx; }
.member-row { display: grid; grid-template-columns: 78rpx minmax(0, 1fr) auto; align-items: center; gap: 16rpx; padding: 18rpx 0; border-top: 1rpx solid rgba(53,70,55,.09); }
.member-avatar, .member-avatar image { width: 72rpx; height: 72rpx; border-radius: 50%; }
.member-avatar { display: flex; align-items: center; justify-content: center; overflow: hidden; color: #fff; background: #78907c; font-family: STKaiti, KaiTi, serif; font-size: 28rpx; }
.member-avatar.partner { background: #d85d3f; }
.member-copy strong, .member-copy small { display: block; }
.member-copy strong { font-family: STKaiti, KaiTi, serif; font-size: 27rpx; }
.member-copy small { margin-top: 4rpx; color: #607263; font-size: 19rpx; }
.member-badge { padding: 8rpx 15rpx; border-radius: 999rpx; color: #56705d; background: rgba(120,144,124,.14); font-size: 18rpx; }
.member-badge.partner { color: #bd4f36; background: rgba(216,93,63,.1); }
.invite-card { margin-top: 16rpx; padding: 24rpx; border: 2rpx dashed rgba(120,144,124,.3); border-radius: 30rpx; text-align: center; }
.invite-card.is-full { border-style: solid; background: rgba(120,144,124,.08); }
.invite-card small, .invite-card strong, .invite-card text { display: block; }
.invite-card small { color: #607263; font-size: 18rpx; }
.invite-card strong { margin: 8rpx 0; font-family: STKaiti, KaiTi, serif; font-size: 42rpx; letter-spacing: 8rpx; }
.invite-card text { color: #607263; font-size: 19rpx; }
.invite-buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 16rpx; }
.invite-buttons button { width: 100%; min-width: 0; margin: 0; padding: 0 14rpx; }
.kitchen-empty { display: flex; align-items: center; margin-bottom: 14rpx; padding: 28rpx; }
.kitchen-empty > text { margin-right: 20rpx; font-size: 50rpx; }
.kitchen-empty strong, .kitchen-empty small { display: block; }
.kitchen-empty strong { font-family: STKaiti, KaiTi, serif; font-size: 28rpx; }
.kitchen-empty small { margin-top: 5rpx; color: #607263; font-size: 20rpx; line-height: 1.45; }
.create-form { margin-top: 14rpx; padding: 22rpx; }
.form-caption { display: block; margin-bottom: 12rpx; font-family: STKaiti, KaiTi, serif; font-size: 26rpx; }
.create-form button { margin-top: 18rpx; }
.join-divider { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14rpx; margin: 22rpx 6rpx 14rpx; }
.join-divider text { height: 1rpx; background: rgba(53,70,55,.13); }
.join-divider small { color: #607263; font-size: 18rpx; }
.join-row, .category-add { display: grid; grid-template-columns: minmax(0, 1fr) 132rpx; gap: 12rpx; }
.join-row input, .category-add input { min-width: 0; }
.join-row button, .category-add button { width: 132rpx; margin: 0; padding: 0; border-radius: 999rpx; color: white; background: #78907c; }
.settings-context { margin-top: 22rpx; padding: 22rpx 26rpx; border-left: 8rpx solid #78907c; border-radius: 0 26rpx 26rpx 0; background: rgba(120,144,124,.09); }
.settings-context small, .settings-context strong, .settings-context text { display: block; }
.settings-context small { color: #607263; font-size: 17rpx; }
.settings-context strong { margin-top: 2rpx; font-family: STKaiti, KaiTi, serif; font-size: 29rpx; }
.settings-context text { margin-top: 4rpx; color: #607263; font-size: 18rpx; }
.settings-card { margin-top: 16rpx; padding: 28rpx; }
.settings-title { display: block; font-family: STKaiti, KaiTi, serif; font-size: 32rpx; font-weight: 700; }
.settings-hint { display: block; margin-top: 6rpx; color: #607263; font-size: 19rpx; }
.settings-card > .primary-button { margin-top: 28rpx; }
.category-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.category-list view { padding: 14rpx 14rpx 14rpx 22rpx; border-radius: 999rpx; background: rgba(255,255,255,.7); font-size: 22rpx; }
.category-list text { margin-left: 10rpx; color: #607263; }
.category-add { margin-top: 20rpx; }
.settings-empty { display: flex; flex-direction: column; align-items: center; margin-top: 22rpx; padding: 40rpx 28rpx; text-align: center; }
.settings-empty > text { font-family: STKaiti, KaiTi, serif; font-size: 30rpx; }
.settings-empty small { margin-top: 10rpx; color: #607263; font-size: 20rpx; line-height: 1.5; }
.settings-empty button { min-height: 64rpx; margin-top: 22rpx; padding: 0 28rpx; border-radius: 999rpx; color: #fff; background: #78907c; font-size: 20rpx; }
button.avatar-picker { display: flex; align-items: center; justify-content: center; width: 190rpx !important; min-width: 190rpx; max-width: 190rpx; height: 190rpx; margin: 8rpx auto 12rpx; padding: 0; overflow: hidden; border: 3rpx dashed rgba(36,59,46,.2); border-radius: 50%; color: #607263; background: rgba(255,255,255,.7); font-size: 22rpx; line-height: 1.35; }
.avatar-picker image { width: 100%; height: 100%; }
.profile-tip { display: block; color: #607263; font-size: 20rpx; text-align: center; }
.save-wechat-profile { margin-top: 30rpx; }
@media (max-width: 360px) { .account-card { grid-template-columns: 78rpx minmax(0, 1fr); } .account-avatar, .account-avatar image { width: 72rpx; height: 72rpx; } button.account-action { grid-column: 1 / 3; width: 100%; } }
