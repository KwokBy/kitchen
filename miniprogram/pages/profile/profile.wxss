.family-card { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-top: 28rpx; padding: 28rpx 22rpx; }
.person { display: flex; align-items: center; }
.person > text { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-right: 14rpx; border-radius: 50%; color: white; background: #243b2e; }
.person strong, .person small { display: block; }
.person small { margin-top: 4rpx; color: #607263; font-size: 18rpx; }
.person.partner { flex-direction: row-reverse; text-align: right; }
.person.partner > text { margin: 0 0 0 14rpx; background: #d85d3f; }
.family-card em { color: #d85d3f; font-family: STKaiti, KaiTi, serif; font-size: 20rpx; font-style: normal; transform: rotate(-5deg); }
.wechat-card { display: grid; grid-template-columns: 72rpx 1fr auto; align-items: center; gap: 16rpx; margin-top: 22rpx; padding: 20rpx; }
.wechat-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border-radius: 22rpx; color: white; background: #1aad19; }
.wechat-card strong, .wechat-card small { display: block; }
.wechat-card small { margin-top: 4rpx; color: #607263; font-size: 18rpx; }
.wechat-card button { padding: 14rpx 20rpx; border-radius: 999rpx; color: white; background: #1aad19; font-size: 20rpx; }
.bound-tag { padding: 8rpx 12rpx; border-radius: 999rpx; color: #187b28; background: rgba(26,173,25,.12); font-size: 18rpx; }
.kitchen-section { margin-top: 22rpx; }
.doorplate { padding: 36rpx; border-radius: 40rpx; color: white; background: #243b2e; text-align: center; box-shadow: 0 24rpx 48rpx rgba(36,59,46,.22); }
.doorplate text, .doorplate strong, .doorplate small { display: block; }
.doorplate > text { margin: 8rpx 0 28rpx; font-family: STKaiti, KaiTi, serif; font-size: 38rpx; font-weight: 700; }
.doorplate strong { margin: 12rpx 0; color: #f2c3a9; font-family: monospace; font-size: 56rpx; letter-spacing: 12rpx; }
.doorplate small { color: rgba(255,255,255,.6); font-size: 19rpx; }
.member-state { margin-top: 24rpx; font-size: 20rpx; }
.invite-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 16rpx; }
.kitchen-empty { display: flex; align-items: center; margin-bottom: 14rpx; padding: 28rpx; }
.kitchen-empty > text { margin-right: 20rpx; font-size: 50rpx; }
.kitchen-empty strong, .kitchen-empty small { display: block; }
.kitchen-empty small { margin-top: 5rpx; color: #607263; font-size: 20rpx; }
.create-form { margin-top: 14rpx; padding: 22rpx; }
.create-form button { margin-top: 18rpx; }
.join-row { display: grid; grid-template-columns: minmax(0, 1fr) 140rpx; gap: 12rpx; margin-top: 16rpx; }
.join-row input { min-width: 0; }
.join-row button { width: 140rpx; margin: 0; padding: 0; }
.join-row button, .category-add button { border-radius: 999rpx; color: white; background: #78907c; }
.settings-card { margin-top: 22rpx; padding: 28rpx; }
.settings-title { display: block; font-family: STKaiti, KaiTi, serif; font-size: 32rpx; font-weight: 700; }
.pair-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14rpx; }
.settings-card > .primary-button { margin-top: 28rpx; }
.category-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.category-list view { padding: 14rpx 14rpx 14rpx 22rpx; border-radius: 999rpx; background: rgba(255,255,255,.7); font-size: 22rpx; }
.category-list text { margin-left: 10rpx; color: #607263; }
.category-add { display: grid; grid-template-columns: minmax(0, 1fr) 140rpx; gap: 12rpx; margin-top: 20rpx; }
.category-add input { min-width: 0; }
.category-add button { width: 140rpx; margin: 0; padding: 0; }
