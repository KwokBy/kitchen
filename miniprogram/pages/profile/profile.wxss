.profile-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-top: 28rpx; padding: 7rpx; border-radius: 999rpx; background: rgba(36,59,46,.07); }
.profile-tabs view { display: flex; align-items: center; justify-content: center; min-height: 68rpx; border-radius: 999rpx; color: #607263; font-size: 22rpx; }
.profile-tabs view.is-active { color: white; background: #243b2e; box-shadow: 0 8rpx 18rpx rgba(36,59,46,.16); }
.family-card { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-top: 28rpx; padding: 28rpx 22rpx; }
.person { display: flex; align-items: center; }
.person > text, .person > image { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-right: 14rpx; border-radius: 50%; color: white; background: #243b2e; }
.person strong, .person small { display: block; }
.person small { margin-top: 4rpx; color: #607263; font-size: 18rpx; }
.person.partner { flex-direction: row-reverse; text-align: right; }
.person.partner > text { margin: 0 0 0 14rpx; background: #d85d3f; }
.family-card em { color: #d85d3f; font-family: STKaiti, KaiTi, serif; font-size: 20rpx; font-style: normal; transform: rotate(-5deg); }
.wechat-login { display: grid; grid-template-columns: 72rpx 1fr auto; align-items: center; gap: 16rpx; width: 100%; min-height: 112rpx; margin-top: 22rpx; padding: 20rpx; color: #243b2e; text-align: left; }
.wechat-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border-radius: 22rpx; color: white; background: #1aad19; }
.wechat-avatar { width: 70rpx; height: 70rpx; border-radius: 22rpx; }
.wechat-login strong, .wechat-login small { display: block; }
.wechat-login strong { font-family: STKaiti, KaiTi, serif; font-size: 28rpx; }
.wechat-login small { margin-top: 4rpx; color: #607263; font-size: 18rpx; }
.login-arrow { color: #607263; font-size: 42rpx; font-weight: 300; }
.logged-tag { padding: 8rpx 12rpx; border-radius: 999rpx; color: #187b28; background: rgba(26,173,25,.12); font-size: 18rpx; }
.overview-links { display: grid; gap: 14rpx; margin-top: 22rpx; }
.overview-links > view { display: grid; grid-template-columns: 66rpx 1fr auto; grid-template-rows: auto auto; align-items: center; min-height: 108rpx; padding: 20rpx 22rpx; border: 1rpx solid rgba(53,70,55,.08); border-radius: 30rpx; background: rgba(255,255,255,.42); }
.overview-links > view > text { grid-row: 1 / 3; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 18rpx; color: white; background: #78907c; font-family: STKaiti, KaiTi, serif; font-size: 25rpx; }
.overview-links strong { align-self: end; font-family: STKaiti, KaiTi, serif; font-size: 27rpx; }
.overview-links small { align-self: start; margin-top: 3rpx; color: #607263; font-size: 18rpx; }
.overview-links em { grid-column: 3; grid-row: 1 / 3; color: #607263; font-size: 38rpx; font-style: normal; }
.kitchen-section { margin-top: 22rpx; }
.doorplate { padding: 36rpx; border-radius: 40rpx; color: white; background: #243b2e; text-align: center; box-shadow: 0 24rpx 48rpx rgba(36,59,46,.22); }
.doorplate text, .doorplate strong, .doorplate small { display: block; }
.doorplate > text { margin: 8rpx 0 28rpx; font-family: STKaiti, KaiTi, serif; font-size: 38rpx; font-weight: 700; }
.doorplate strong { margin: 12rpx 0; color: #f2c3a9; font-family: monospace; font-size: 56rpx; letter-spacing: 12rpx; }
.doorplate small { color: rgba(255,255,255,.6); font-size: 19rpx; }
.member-state { margin-top: 24rpx; font-size: 20rpx; }
.invite-buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 16rpx; }
.invite-buttons button { width: 100%; min-width: 0; margin: 0; padding: 0 14rpx; }
.kitchen-empty { display: flex; align-items: center; margin-bottom: 14rpx; padding: 28rpx; }
.kitchen-empty > text { margin-right: 20rpx; font-size: 50rpx; }
.kitchen-empty strong, .kitchen-empty small { display: block; }
.kitchen-empty small { margin-top: 5rpx; color: #607263; font-size: 20rpx; }
.create-form { margin-top: 14rpx; padding: 22rpx; }
.create-form button { margin-top: 18rpx; }
.join-row { display: grid; grid-template-columns: minmax(0, 1fr) 140rpx; gap: 12rpx; margin-top: 16rpx; }
.join-row input { min-width: 0; }
.join-row button { width: 140rpx; margin: 0; padding: 0; }
.join-row button, .category-add button { border-radius: 999rpx; color: white; background: #78907c; }
.settings-card { margin-top: 22rpx; padding: 28rpx; }
.settings-title { display: block; font-family: STKaiti, KaiTi, serif; font-size: 32rpx; font-weight: 700; }
.settings-hint { display: block; margin-top: 6rpx; color: #607263; font-size: 19rpx; }
.pair-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14rpx; }
.settings-card > .primary-button { margin-top: 28rpx; }
.category-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.category-list view { padding: 14rpx 14rpx 14rpx 22rpx; border-radius: 999rpx; background: rgba(255,255,255,.7); font-size: 22rpx; }
.category-list text { margin-left: 10rpx; color: #607263; }
.category-add { display: grid; grid-template-columns: minmax(0, 1fr) 140rpx; gap: 12rpx; margin-top: 20rpx; }
.category-add input { min-width: 0; }
.category-add button { width: 140rpx; margin: 0; padding: 0; }
button.avatar-picker { display: flex; align-items: center; justify-content: center; width: 190rpx !important; min-width: 190rpx; max-width: 190rpx; height: 190rpx; margin: 8rpx auto 12rpx; padding: 0; overflow: hidden; border: 3rpx dashed rgba(36,59,46,.2); border-radius: 50%; color: #607263; background: rgba(255,255,255,.7); font-size: 22rpx; line-height: 1.35; }
.avatar-picker image { width: 100%; height: 100%; }
.profile-tip { display: block; color: #607263; font-size: 20rpx; text-align: center; }
.save-wechat-profile { margin-top: 30rpx; }
