<view class="page-shell menu-page">
  <view class="menu-heading"><view><text class="eyebrow">已有菜单</text><text class="page-title">这就是..我的实力吗！</text></view><button class="wish-label" bindtap="openPicker">✧ 想吃的菜</button></view>

  <view wx:if="{{selectedDish}}" class="menu-stage">
    <scroll-view scroll-y class="dish-name-list">
      <text wx:for="{{dishes}}" wx:key="id" class="dish-name {{index === selectedIndex ? 'is-active' : ''}}" data-index="{{index}}" bindtap="selectDish">{{item.name}}</text>
    </scroll-view>
    <view class="round-table {{tableMotion}}" bindtouchstart="onMenuTouchStart" bindtouchend="onMenuTouchEnd"><view class="selected-plate dish-composite {{plateMotion}}"><image class="plate-layer" src="{{selectedDish.plateImage}}" mode="aspectFit" /><image class="food-layer" src="{{selectedDish.image}}" mode="aspectFit" /></view></view>
  </view>
  <view wx:else class="empty-menu paper-card">还没有菜，先新增第一道。</view>

  <view wx:if="{{selectedDish}}" class="selected-copy"><text>{{selectedDish.name}}</text><small>♥ {{selectedDish.wishText}}{{selectedDish.planDates.length ? ' · 已安排 ' + selectedDish.planDates.length + ' 天' : ''}}</small><small wx:if="{{selectedDish.note}}">{{selectedDish.note}}</small><small wx:if="{{dishes.length > 1}}" class="menu-swipe-hint">← 左右滑动换菜 →</small></view>
  <view class="menu-actions"><button class="soft-button add" bindtap="addDish">＋ 新增</button><button class="primary-button" bindtap="arrangeDish">安排</button><button class="soft-button" bindtap="editDish">编辑</button><button class="remove-button" bindtap="removeDish">移出</button></view>

  <view class="section-head"><text>这几天吃什么</text><text>她也可以来安排</text></view>
  <scroll-view scroll-x class="week-strip">
    <view class="day-card" wx:for="{{weekDays}}" wx:key="value" data-date="{{item.value}}" bindtap="openDay"><text>{{item.label}} · {{item.dateText}}</text><view wx:if="{{item.dishes.length}}" class="day-dish-image dish-composite"><image class="plate-layer" src="{{item.dishes[0].plateImage}}" mode="aspectFit" /><image class="food-layer" src="{{item.dishes[0].image}}" mode="aspectFit" /></view><view wx:else class="day-plus">＋</view><small>{{item.dishes.length ? item.dishes[0].name : '还没安排'}}</small><em wx:if="{{item.dishes.length > 1}}">另有 {{item.dishes.length - 1}} 道</em></view>
  </scroll-view>
  <button class="basket-entry" bindtap="openBasket"><view><strong>{{plannedCount ? '已安排 ' + plannedCount + ' 道菜' : '先安排菜单，再准备食材'}}</strong><small>{{plannedCount ? '去菜篮子对照冰箱库存' : '菜篮会自动汇总用料'}}</small></view><text>›</text></button>
</view>

<view wx:if="{{showAddChoice}}" class="sheet-overlay" bindtap="closeSheets">
  <view class="bottom-sheet add-choice-sheet" catchtap="noop">
    <view class="sheet-head"><view><text>{{addChoiceDate ? '添加到当天' : '菜单收菜'}}</text><strong>想怎么加这道菜</strong></view><button class="sheet-close" bindtap="closeSheets">×</button></view>
    <view class="add-choice" bindtap="chooseExistingDish"><view class="choice-mark">菜</view><view><strong>从已有的菜添加</strong><small>去菜本里挑一道，直接安排进菜单</small></view><text>›</text></view>
    <view class="add-choice new" bindtap="createNewDish"><view class="choice-mark">＋</view><view><strong>新建一道菜</strong><small>添加照片、食材和做菜备注</small></view><text>›</text></view>
  </view>
</view>

<view wx:if="{{showArrange}}" class="sheet-overlay" bindtap="closeSheets">
  <view class="bottom-sheet arrange-sheet" catchtap="noop">
    <view class="sheet-head"><view><text>安排菜品</text><strong>哪天吃这道菜</strong></view><button class="sheet-close" bindtap="closeSheets">×</button></view>
    <view class="sheet-dish"><view class="sheet-dish-image dish-composite"><image class="plate-layer" src="{{selectedDish.plateImage}}" mode="aspectFit" /><image class="food-layer" src="{{selectedDish.image}}" mode="aspectFit" /></view><view><strong>{{selectedDish.name}}</strong><small>{{selectedDish.planDates.length ? '已安排 ' + selectedDish.planDates.length + ' 天，还可以继续加' : '还没有安排日期'}}</small></view></view>
    <view class="date-chips"><view wx:for="{{dateOptions}}" wx:key="value" class="date-chip {{arrangeDate === item.value ? 'is-active' : ''}}" data-date="{{item.value}}" bindtap="chooseArrangeDate">{{item.label}}</view></view>
    <button class="primary-button" bindtap="confirmArrange">安排进这一天</button>
  </view>
</view>

<view wx:if="{{showPicker}}" class="sheet-overlay" bindtap="closeSheets">
  <view class="bottom-sheet picker-sheet" catchtap="noop">
    <view class="sheet-head"><view><text>今天听谁的</text><strong>挑几道想吃的</strong></view><button class="sheet-close" bindtap="closeSheets">×</button></view>
    <view class="picker-filters"><view class="{{pickerMode === 'all' ? 'is-active' : ''}}" data-mode="all" bindtap="changePickerMode">全部菜</view><view class="{{pickerMode === 'me' ? 'is-active' : ''}}" data-mode="me" bindtap="changePickerMode">我想吃</view><view class="{{pickerMode === 'both' ? 'is-active' : ''}}" data-mode="both" bindtap="changePickerMode">我们都想吃</view></view>
    <scroll-view wx:if="{{pickerDishes.length}}" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{true}}" enable-flex="{{true}}" class="picker-grid-scroll">
      <view class="picker-grid">
        <view wx:for="{{pickerDishes}}" wx:key="id" class="picker-card {{item.isSelected ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="selectPickerDish">
          <view class="picker-plate dish-composite"><image class="plate-layer" src="{{item.plateImage}}" mode="aspectFit" /><image class="food-layer" src="{{item.image}}" mode="aspectFit" /></view>
          <view class="picker-card-copy"><strong>{{item.name}}</strong><small>{{item.wishText}}</small></view>
          <text wx:if="{{item.isSelected}}" class="picker-check">✓</text>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{pickerDishes.length > 6}}" class="picker-scroll-hint">↑ 上滑查看更多</view>
    <view wx:if="{{!pickerDishes.length}}" class="picker-empty">这个筛选里还没有菜</view>
    <text class="picker-date-label">安排到哪一天</text>
    <view class="date-chips"><view wx:for="{{dateOptions}}" wx:key="value" class="date-chip {{pickerDate === item.value ? 'is-active' : ''}}" data-date="{{item.value}}" bindtap="choosePickerDate">{{item.label}}</view></view>
    <button class="primary-button" disabled="{{!pickerSelectedIds.length}}" bindtap="confirmPicker">{{pickerSelectedIds.length ? '安排 ' + pickerSelectedIds.length + ' 道菜进菜单' : '先选择想吃的菜'}}</button>
  </view>
</view>

<view wx:if="{{showDay}}" class="sheet-overlay" bindtap="closeSheets">
  <view class="bottom-sheet day-sheet" catchtap="noop">
    <view class="sheet-head"><view><text>当天菜单</text><strong>{{activeDay.label}}吃什么</strong></view><button class="sheet-close" bindtap="closeSheets">×</button></view>
    <view wx:for="{{activeDay.dishes}}" wx:key="id" class="day-dish-row"><view class="day-row-image dish-composite"><image class="plate-layer" src="{{item.plateImage}}" mode="aspectFit" /><image class="food-layer" src="{{item.image}}" mode="aspectFit" /></view><view><strong>{{item.name}}</strong><small>{{item.wishText}}</small></view><button data-id="{{item.id}}" bindtap="editDayDish">编辑</button><button class="unschedule" data-id="{{item.id}}" bindtap="unscheduleDish">移出当天</button></view>
    <view wx:if="{{!activeDay.dishes.length}}" class="picker-empty">这天还没有安排菜</view>
    <button class="soft-button day-add" bindtap="addDishToDay">＋ 再安排一道菜</button>
  </view>
</view>
