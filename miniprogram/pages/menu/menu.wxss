.menu-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.menu-heading .page-title { display: block; }
.menu-heading .page-title { white-space: nowrap; font-size: 40rpx; }
.wish-label { width: auto; min-height: 58rpx; margin: 0; padding: 0 10rpx; color: #607263; background: transparent; font-family: STKaiti, KaiTi, serif; font-size: 24rpx; }
.menu-stage { display: grid; grid-template-columns: 190rpx 1fr; align-items: center; min-height: 570rpx; margin: 0 -36rpx; overflow: hidden; }
.dish-name-list { z-index: 2; height: 460rpx; padding-left: 36rpx; }
.dish-name { display: block; padding: 11rpx 0; color: rgba(36,59,46,.4); font-family: STKaiti, KaiTi, serif; font-size: 27rpx; }
.dish-name.is-active { color: #78907c; font-size: 30rpx; font-weight: 700; transform: translateX(12rpx); }
.round-table { position: relative; width: 570rpx; height: 570rpx; border-radius: 50%; background: repeating-linear-gradient(0deg, transparent 0 38rpx, rgba(68,96,65,.3) 38rpx 74rpx), repeating-linear-gradient(90deg, rgba(176,91,64,.34) 0 37rpx, rgba(245,239,215,.5) 37rpx 74rpx); box-shadow: inset 0 0 0 16rpx rgba(255,255,255,.22), 0 28rpx 54rpx rgba(55,60,50,.17); transform: translateX(-8rpx); }
.round-table.table-spin-forward { animation: table-spin-forward .5s cubic-bezier(.22,.75,.3,1); }
.round-table.table-spin-backward { animation: table-spin-backward .5s cubic-bezier(.22,.75,.3,1); }
.selected-plate { position: absolute; left: 50%; top: 50%; display: flex; align-items: center; justify-content: center; width: 310rpx; height: 310rpx; overflow: hidden; border-radius: 50%; box-shadow: 0 28rpx 44rpx rgba(48,52,45,.27); transform: translate(-50%, -50%); }
.selected-plate.plate-enter-forward { animation: plate-enter-forward .5s cubic-bezier(.2,.8,.25,1); }
.selected-plate.plate-enter-backward { animation: plate-enter-backward .5s cubic-bezier(.2,.8,.25,1); }
.selected-plate.plate-sage { background: #819584; }
.selected-plate.plate-cream { background: #ded2b8; }
.selected-plate.plate-pink { background: #dfa59a; }
.selected-plate.plate-blue { background: #cbdad2; }
.selected-plate image { width: 100%; height: 100%; border-radius: 50%; transform: scale(1.2); }
@keyframes table-spin-forward { 0% { transform: translateX(-8rpx) rotate(0); } 55% { transform: translateX(-8rpx) rotate(12deg); } 100% { transform: translateX(-8rpx) rotate(0); } }
@keyframes table-spin-backward { 0% { transform: translateX(-8rpx) rotate(0); } 55% { transform: translateX(-8rpx) rotate(-12deg); } 100% { transform: translateX(-8rpx) rotate(0); } }
@keyframes plate-enter-forward { 0% { opacity: .28; transform: translate(-18%, -82%) scale(.76) rotate(14deg); } 72% { opacity: 1; transform: translate(-53%, -47%) scale(1.04) rotate(-2deg); } 100% { transform: translate(-50%, -50%) scale(1) rotate(0); } }
@keyframes plate-enter-backward { 0% { opacity: .28; transform: translate(-82%, -18%) scale(.76) rotate(-14deg); } 72% { opacity: 1; transform: translate(-47%, -53%) scale(1.04) rotate(2deg); } 100% { transform: translate(-50%, -50%) scale(1) rotate(0); } }
.selected-copy { margin-top: -12rpx; text-align: center; }
.selected-copy text { display: block; font-family: STKaiti, KaiTi, serif; font-size: 38rpx; font-weight: 700; }
.selected-copy small { display: block; margin-top: 8rpx; color: #607263; font-size: 21rpx; }
.menu-actions { display: flex; flex-direction: column; margin-top: 22rpx; }
.menu-actions button { width: 100%; margin-top: 12rpx; }
.menu-actions .add { width: 280rpx; }
.remove-button { min-height: 78rpx; color: #d85d3f; background: transparent; font-size: 25rpx; }
.week-strip { width: 100%; white-space: nowrap; }
.day-card { display: inline-flex; flex-direction: column; align-items: center; width: 170rpx; min-height: 220rpx; margin-right: 12rpx; padding: 18rpx 10rpx; border-radius: 28rpx; background: rgba(255,255,255,.42); }
.day-card > text { color: #607263; font-size: 20rpx; }
.day-card image, .day-plus { width: 100rpx; height: 100rpx; margin: 12rpx 0; border-radius: 50%; }
.day-card image { border: 8rpx solid rgba(255,255,255,.8); }
.day-plus { display: flex; align-items: center; justify-content: center; border: 2rpx dashed rgba(53,70,55,.2); color: #607263; font-size: 34rpx; }
.day-card small { max-width: 150rpx; overflow: hidden; font-family: STKaiti, KaiTi, serif; font-size: 22rpx; text-overflow: ellipsis; }
.day-card em { margin-top: 5rpx; color: #d85d3f; font-size: 18rpx; font-style: normal; }
.empty-menu { padding: 80rpx 20rpx; text-align: center; }
.basket-entry { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 112rpx; margin-top: 22rpx; padding: 20rpx 26rpx; border-radius: 28rpx; color: white; background: #243b2e; text-align: left; }
.basket-entry view { flex: 1; }
.basket-entry strong, .basket-entry small { display: block; }
.basket-entry strong { font-family: STKaiti, KaiTi, serif; font-size: 28rpx; }
.basket-entry small { margin-top: 6rpx; color: rgba(255,255,255,.65); font-size: 19rpx; }
.basket-entry > text { font-size: 42rpx; font-weight: 300; }
.sheet-dish { display: flex; align-items: center; padding: 20rpx; border-radius: 28rpx; background: rgba(255,255,255,.55); }
.sheet-dish image { width: 104rpx; height: 104rpx; margin-right: 22rpx; border: 10rpx solid rgba(255,255,255,.75); border-radius: 50%; }
.sheet-dish strong, .sheet-dish small { display: block; }
.sheet-dish strong { font-family: STKaiti, KaiTi, serif; font-size: 30rpx; }
.sheet-dish small { margin-top: 5rpx; color: #607263; font-size: 20rpx; }
.picker-sheet { overflow-x: hidden; }
.picker-filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; width: 100%; }
.picker-filters > view { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 66rpx; padding: 0 6rpx; border: 1rpx solid rgba(53,70,55,.13); border-radius: 999rpx; color: #607263; background: rgba(255,255,255,.62); font-size: 20rpx; }
.picker-filters > view.is-active { color: white; border-color: #243b2e; background: #243b2e; }
.picker-grid-scroll { height: 390rpx; margin: 20rpx 0 10rpx; }
.picker-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; padding-bottom: 8rpx; }
.picker-card { position: relative; display: flex; align-items: center; min-width: 0; min-height: 118rpx; padding: 12rpx; border: 2rpx solid transparent; border-radius: 28rpx; background: rgba(255,255,255,.52); }
.picker-card.is-active { border-color: #78907c; background: rgba(120,144,124,.15); }
.picker-plate { display: flex; flex: 0 0 88rpx; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; }
.picker-plate image { width: 66rpx; height: 66rpx; border-radius: 50%; }
.picker-card-copy { min-width: 0; margin-left: 12rpx; padding-right: 14rpx; }
.picker-card-copy strong, .picker-card-copy small { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.picker-card-copy strong { font-family: STKaiti, KaiTi, serif; font-size: 25rpx; }
.picker-card-copy small { margin-top: 5rpx; color: #607263; font-size: 17rpx; }
.picker-check { position: absolute; right: 8rpx; top: 8rpx; display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border-radius: 50%; color: white; background: #78907c; font-size: 17rpx; }
.plate-sage { border: 12rpx solid #819584; background: rgba(255,255,255,.88); }
.plate-cream { border: 12rpx solid #ded2b8; background: rgba(255,255,255,.9); }
.plate-pink { border: 12rpx dotted #dfa59a; background: rgba(255,255,255,.9); }
.plate-blue { border: 12rpx double #cbdad2; background: rgba(255,255,255,.92); }
.picker-date-label { display: block; margin-top: 4rpx; font-size: 23rpx; font-weight: 600; }
.picker-empty { padding: 60rpx 20rpx; color: #607263; text-align: center; }
.day-dish-row { display: grid; grid-template-columns: 90rpx 1fr 88rpx 112rpx; align-items: center; gap: 12rpx; margin-bottom: 14rpx; padding: 16rpx; border-radius: 28rpx; background: rgba(255,255,255,.55); }
.day-dish-row image { width: 82rpx; height: 82rpx; border-radius: 50%; }
.day-dish-row strong, .day-dish-row small { display: block; }
.day-dish-row strong { font-family: STKaiti, KaiTi, serif; font-size: 26rpx; }
.day-dish-row small { margin-top: 4rpx; color: #607263; font-size: 18rpx; }
.day-dish-row button { width: 100%; min-width: 0; min-height: 56rpx; margin: 0; padding: 0 8rpx; border-radius: 999rpx; color: #243b2e; background: rgba(36,59,46,.08); font-size: 19rpx; }
.day-dish-row button.unschedule { color: #d85d3f; background: rgba(216,93,63,.08); }
.day-add { margin-top: 18rpx; }
